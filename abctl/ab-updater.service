[Unit]
Description=Boot-success Flag Updater

[Service]
User=ab-updater
Group=ab-updater
SupplementaryGroups=disk
Restart=no
RemainAfterExit=yes
ExecStart=/bin/sh -c " \
            if [ \"$(/usr/sbin/abctl --boot_slot)\" == \"_a\" ] || \
               [ \"$(/usr/sbin/abctl --boot_slot)\" == \"_b\" ] ; \
                 then /usr/sbin/abctl --set_success; else \
                 /sbin/echo \"invalid boot slot\" > /dev/kmsg; exit 1; fi \
          "

[Install]
WantedBy=sysinit.target
